{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Solr REST Collections Config API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8983/api/c/:collection/config",
            "params": [
              {
                "name": "collection",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get configuration"
        },
        {
          "info": {
            "name": "Modify configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8983/api/c/:collection/config",
            "params": [
              {
                "name": "collection",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Modify configuration"
        }
      ]
    }
  ],
  "bundled": true
}